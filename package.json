{
	"name": "atom-clicker-ssr",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"benchmark": "vite dev --open /benchmark",
		"bench": "bun run scripts/benchmark.ts",
		"db:start": "supabase start",
		"db:stop": "supabase stop",
		"db:status": "supabase status",
		"db:reset": "supabase db reset",
		"db:diff": "supabase db diff",
		"db:push": "supabase db push --remote",
		"db:types": "supabase gen types typescript > src/lib/types/supabase.ts"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "8.0.2",
		"@sveltejs/kit": "3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "4.3.4",
		"@types/bun": "^1.4.4",
		"@types/node": "^26.6.6",
		"@types/three": "^0.187.0",
		"supabase": "^3.0.0",
		"svelte": "^5.57.3",
		"svelte-check": "4.7.8",
		"tailwindcss": "4.3.4",
		"typescript": "6.0.3",
		"vite": "8.3.5",
		"wrangler": "^4.157.0"
	},
	"dependencies": {
		"@lucide/svelte": "^1.67.0",
		"@supabase/supabase-js": "2.118.0",
		"three": "0.187.0",
		"virtua": "^0.54.1"
	},
	"imports": {
		"#components/*": "./src/lib/components/*",
		"#data/*": "./src/lib/data/*",
		"#helpers/*": "./src/lib/helpers/*",
		"#lib/*": "./src/lib/*",
		"#stores/*": "./src/lib/stores/*"
	},
	"packageManager": "bun@1.4.4",
	"trustedDependencies": [
		"esbuild",
		"workerd"
	],
	"type": "module"
}
