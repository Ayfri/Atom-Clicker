{
	"name": "atom-clicker-ssr",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"benchmark": "vite dev --open /benchmark",
		"bench": "bun run scripts/benchmark.ts",
		"db:start": "supabase start",
		"db:stop": "supabase stop",
		"db:status": "supabase status",
		"db:reset": "supabase db reset",
		"db:diff": "supabase db diff",
		"db:push": "supabase db push",
		"db:types": "supabase gen types typescript --local > src/lib/types/supabase.ts"
	},
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "7.2.9",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "4.3.3",
		"supabase": "^2.117.0",
		"svelte": "^5.57.0",
		"svelte-check": "4.7.6",
		"tailwindcss": "4.3.3",
		"typescript": "6.0.3",
		"vite": "8.2.2",
		"wrangler": "^4.130.0"
	},
	"dependencies": {
		"@lucide/svelte": "^1.43.0",
		"@supabase/supabase-js": "2.116.0",
		"@types/node": "^26.5.1",
		"@xyflow/svelte": "1.6.6",
		"marked": "18.0.12",
		"virtua": "^0.51.2"
	},
	"packageManager": "bun@1.4.2",
	"trustedDependencies": [
		"esbuild",
		"svelte-preprocess",
		"workerd"
	],
	"type": "module"
}
